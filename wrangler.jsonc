{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "viaje",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "TRIP_ID": "default"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "viaje",
      "database_id": "REEMPLAZAR_CON_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
